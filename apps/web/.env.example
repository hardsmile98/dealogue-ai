# Базовый URL backend-API (NestJS из apps/api).
# Если переменная не задана или пустая — форма входа работает в демо-режиме
# (логин: demo, пароль: demo1234) и не ходит в сеть.
VITE_API_URL=http://localhost:3000

# Раздел «Аккаунты Telegram» работает на локальном моке, пока в apps/api
# нет эндпоинтов /telegram/*. Чтобы ходить в реальный API — выставьте false.
VITE_MOCK_TELEGRAM=true
