# Скопируйте в .env: cp .env.example .env

PORT=3000

# Через запятую — origin'ы, которым разрешён CORS (dev-сервер Vite).
CORS_ORIGIN=http://localhost:5173

# Postgres. Значения совпадают с docker-compose.yml в корне репозитория.
DB_HOST=localhost
DB_PORT=5432
DB_USER=dealogue
DB_PASSWORD=dealogue
DB_NAME=dealogue
DB_LOGGING=false

# Обязателен: приложение не стартует без него.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Логин и пароль пользователя, которого создаёт сид-миграция SeedDemoUser.
# Читаются только в момент `npm run migration:run`; логин приводится к нижнему
# регистру. Менять до первого запуска миграций — уже применённая миграция
# повторно не выполнится (иначе: migration:revert, потом migration:run).
SEED_USER_LOGIN=demo
SEED_USER_PASSWORD=demo1234
