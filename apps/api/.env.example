# Скопируйте в .env: cp .env.example .env

PORT=3000

# Через запятую — origin'ы, которым разрешён CORS (dev-сервер Vite).
CORS_ORIGIN=http://localhost:5173

# Postgres. Значения совпадают с docker-compose.yml в корне репозитория.
DB_HOST=localhost
DB_PORT=5432
DB_USER=dealogue
DB_PASSWORD=dealogue
DB_NAME=dealogue
DB_LOGGING=false

# Обязателен: приложение не стартует без него.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Логин и пароль пользователя, которого создаёт сид-миграция SeedDemoUser.
# Читаются только в момент `npm run migration:run`; логин приводится к нижнему
# регистру. Менять до первого запуска миграций — уже применённая миграция
# повторно не выполнится (иначе: migration:revert, потом migration:run).
SEED_USER_LOGIN=demo
SEED_USER_PASSWORD=demo1234

# --- Telegram (teleproto) ----------------------------------------------------
# api_id / api_hash приложения с https://my.telegram.org/apps.
# Без них раздел Telegram выключен: эндпоинты /telegram/* отвечают 503.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Ключ шифрования сессий Telegram в базе (AES-256-GCM). Обязателен, если
# заданы api_id/api_hash. Потеря ключа = все аккаунты придётся переподключить.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_SESSION_SECRET=

# MTProxy — из России Telegram напрямую недоступен. Формат host:port:secret,
# несколько прокси через запятую: подключаемся к первому живому, при сбое
# переходим к следующему. Секрет — hex (dd… для random padding, ee… для fake-TLS).
TELEGRAM_MTPROXY=proxy.example.com:443:ee00000000000000000000000000000000676f6f676c652e636f6d

# В какой зоне считать «день» в статистике по умолчанию (фронтенд передаёт свою).
TELEGRAM_TIMEZONE=Europe/Moscow

# Первичная синхронизация: сколько личных диалогов и сколько последних
# сообщений на диалог забирать при подключении аккаунта.
TELEGRAM_SYNC_DIALOGS_LIMIT=300
TELEGRAM_SYNC_MESSAGES_LIMIT=100

# Досинхронизация: как часто (сек) и сколько свежих диалогов проверять.
# Страхует от пропущенных событий после обрывов связи.
TELEGRAM_RESYNC_INTERVAL_SEC=120
TELEGRAM_RESYNC_DIALOGS_LIMIT=40

# Сколько секунд живёт незавершённый вход (номер → код → пароль).
TELEGRAM_LOGIN_ATTEMPT_TTL_SEC=600
